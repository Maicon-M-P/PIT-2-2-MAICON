# Copie este arquivo para .env e preencha com seus dados.
# NUNCA commite o arquivo .env (ele está no .gitignore).

# Supabase
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua-service-role-key-aqui
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres

# Login do administrador (único usuário do painel)
ADMIN_USER=admin
ADMIN_PASSWORD=senha123

# Chave usada para assinar o token de acesso do admin
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# URL do front-end (usada no CORS)
FRONTEND_URL=https://seu-front.vercel.app

# Porta local (opcional)
PORT=5000
